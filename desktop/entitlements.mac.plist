<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The exceptions of the hardened runtime that a signed and notarized app needs (#5615), for the app and for each
     program in it (the bundled Python, the dictation helper):
     allow-jit and allow-unsigned-executable-memory: Electron's JavaScript engine, and Python's ctypes;
     disable-library-validation: Python loads its own extension modules (lib-dynload);
     device.audio-input: the page records speech for dictation. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
