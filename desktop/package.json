{
  "name": "maximizepm",
  "productName": "MaximizePM",
  "version": "0.2.0",
  "description": "MaximizePM dashboard in its own window: runs maxpm serve and shows the page.",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --mac dmg --arm64 --x64 --publish never",
    "python": "node scripts/fetch-python.js",
    "predist": "node scripts/fetch-python.js mac-arm64 mac-x64",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "predist:win": "node scripts/fetch-python.js win-x64",
    "icon": "electron scripts/make-icon.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.maximizepm.app",
    "productName": "MaximizePM",
    "publish": null,
    "directories": {
      "output": "out"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../bin",
        "to": "river-app/bin"
      },
      {
        "from": "../river",
        "to": "river-app/river",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "build/python/${os}-${arch}/python",
        "to": "river-app/python"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "target": "dmg",
      "icon": "icon.png",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "MaximizePM-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "artifactName": "MaximizePM-${version}-${arch}-setup.${ext}"
    }
  }
}
